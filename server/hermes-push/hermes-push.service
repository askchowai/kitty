# systemd user unit for the hermes-push companion.
#   mkdir -p ~/.config/systemd/user && cp hermes-push.service ~/.config/systemd/user/
#   cp hermes-push.env.example ~/.config/hermes-push.env   # then fill it in
#   systemctl --user daemon-reload && systemctl --user enable --now hermes-push
#   loginctl enable-linger $USER   # keep it running when you are logged out
[Unit]
Description=hermes-push — APNs relay for the Kitty apps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hermes-push.env
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/.hermes/hermes-push/hermes_push.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
