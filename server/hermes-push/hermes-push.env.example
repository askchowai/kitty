# Copy to ~/.config/hermes-push.env and fill in. Placeholders only — never commit real values.
HERMES_PUSH_GATEWAY_URL=http://127.0.0.1:9119
HERMES_PUSH_GATEWAY_TOKEN=REPLACE_WITH_HERMES_DASHBOARD_SESSION_TOKEN
# HERMES_PUSH_GATEWAY_BEARER=            # instead of TOKEN when the auth gate is on
# HERMES_PUSH_CF_ACCESS_CLIENT_ID=       # only if the URL is behind Cloudflare Access
# HERMES_PUSH_CF_ACCESS_CLIENT_SECRET=
HERMES_PUSH_APNS_KEY_FILE=/home/you/.config/AuthKey_XXXXXXXXXX.p8
HERMES_PUSH_APNS_KEY_ID=XXXXXXXXXX
HERMES_PUSH_APNS_TEAM_ID=YYYYYYYYYY
# HERMES_PUSH_APNS_TOPIC=com.vorantx.kitty   # fallback only; each device file carries its own bundle id
